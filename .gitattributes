# =============================================================================
# Unity project .gitattributes
# =============================================================================

# --- Unity YAML merge ------------------------------------------------------
# Scene and prefab files are YAML. Without a merge driver git treats them as
# opaque text and a merge produces a file that is not valid YAML -- Unity then
# refuses to open the scene. UnityYAMLMerge does a semantic merge on them.
#
# ONE MANUAL STEP PER CLONE. The driver has to be registered in each machine's
# .git/config; it is not committable. Run this once after cloning:
#
#   git config merge.unityyamlmerge.name  "Unity SmartMerge"
#   git config merge.unityyamlmerge.driver \
#     '"$UNITY_PATH/Editor/Data/Tools/UnityYAMLMerge" merge -p %O %B %A %A'
#
# On Linux UnityYAMLMerge ships with the editor under Editor/Data/Tools/.
# Without the driver registered, git falls back to a plain 3-way merge on these
# files -- which is the situation today, and it is worth fixing.
*.unity   merge=unityyamlmerge eol=lf
*.prefab  merge=unityyamlmerge eol=lf
*.asset   merge=unityyamlmerge eol=lf
*.mat     merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.meta    merge=unityyamlmerge eol=lf

# --- Binary ----------------------------------------------------------------
# Unity asset containers are binary. Marking them stops git attempting a text
# diff and stops it "fixing" line endings on checkout, which corrupts them.
*.fbx     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.psd     binary
*.tga     binary
*.exr     binary
*.glb     binary
*.gltf    binary
*.wav     binary
*.mp3     binary
*.dll     binary
*.so      binary
*.bundle  binary

# --- Text ------------------------------------------------------------------
*.cs      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.xml     text eol=lf
Makefile  text eol=lf

# --- Git LFS: deliberately NOT enabled, and here is the threshold ----------
#
# The payload does not justify it. Measured 2026-10-01: 85 FBX totalling
# 3.7 MB, median file 20 KB, largest 578 KB (a whole assembled scene). Git
# stores that natively with no trouble, and LFS would cost every teammate a
# git-lfs install, a remote that supports it, and a bandwidth quota.
#
# Turn it on when the payload crosses roughly 100 MB, or when a single file
# crosses roughly 5 MB -- which Phase 2's textures could do. Uncomment then,
# and run `git lfs install && git lfs migrate import --include="*.fbx,*.png"`
# once. Until then these lines stay commented out on purpose so nobody
# clones a repo full of LFS pointer stubs they cannot resolve.
#
# *.fbx   filter=lfs diff=lfs merge=lfs -text
# *.png   filter=lfs diff=lfs merge=lfs -text
# *.glb   filter=lfs diff=lfs merge=lfs -text
# *.psd   filter=lfs diff=lfs merge=lfs -text
# *.tga   filter=lfs diff=lfs merge=lfs -text
